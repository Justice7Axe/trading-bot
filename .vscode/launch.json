{
  "version": "0.2.0",
  "configurations": [
  
    {
      "name": "Kiwoom Ingestion (F5)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}\\kiwoom_trading\\ingestion\\run_ingestion.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
    },
    {
      "name": "Kiwoom Analysis",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}\\kiwoom_trading\\analysis\\run_analysis.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
    },
    {
      "name": "Kiwoom Web Chart",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}\\kiwoom_trading\\analysis\\web_chart_app.py"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
    }
  ]
}
